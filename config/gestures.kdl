// Touchscreen gestures for the niri-tablet patchset.
//
// Include from your main config (config.kdl):
//     include "~/.config/niri/cfg/gestures.kdl"
// or paste the block straight in. Every node takes any niri action, same as
// keybinds — the ones below are a sensible starting point (the compiled
// defaults are tamer: 3-tap maximize, the rest unbound).
gestures {
    // Touch point visualization (demo videos, gesture debugging): translucent
    // dots follow the fingers, rendered by the compositor — any screen
    // recorder captures them, input is never touched. Off unless configured.
    //   "gestures"  dots only while 3+/4-finger gesture touches are down
    //   "all"       every finger (debugging)
    show-touch-points "gestures";

    // Gesture debug logging (bug reports): every finger down/up/motion with
    // timestamps, recognition decisions and dispatched actions, at info level
    // with a "gesture-debug:" prefix. Collect with:
    //   journalctl --user -u niri.service --since -10m | grep gesture-debug
    // Can be toggled live; takes effect from the next touch. Off by default.
    // debug-log

    touchscreen-swipe {
        // Minimum fingers for the animated swipes (drag = view scroll
        // horizontally, workspace carousel vertically).
        fingers 3

        // 3-finger tap: maximize / restore the focused column (also the default).
        tap { maximize-column; }

        // 4-finger tap: window overview — niri-native, works everywhere.
        // Prefer an app launcher? Swap in one of these (any spawn works):
        //   Noctalia: spawn-sh "noctalia msg panel-toggle launcher"
        //   fuzzel:   spawn "fuzzel"
        //   wofi:     spawn "wofi" "--show" "drun"
        //   rofi:     spawn "rofi" "-show" "drun"
        // Or remove the node — unbound is the compiled default.
        tap-4 { toggle-overview; }

        // 4-finger flick down: close the focused window (discrete, fires on lift).
        swipe-4-down { close-window; }

        // 4-finger flick up: toggle the on-screen keyboard
        // (scripts/niri-osk.sh from this repo, at ~/.local/bin/niri-osk.sh).
        swipe-4-up { spawn-sh "~/.local/bin/niri-osk.sh"; }

        // Hold-swipe: press, rest the fingers still for a moment (~400ms),
        // then swipe — the dominant direction runs its action. Quick swipes
        // are unaffected (they keep driving the animated view/carousel);
        // unset a direction and held swipes that way fall back to animated.
        // Below: held swipe moves the focused window left/right one column
        // or up/down one workspace — any action can be bound instead.
        hold {
            left { move-column-left; }
            right { move-column-right; }
            up { move-window-to-workspace-up; }
            down { move-window-to-workspace-down; }
        }
    }

    // Edge swipes — single finger starting within ~48px of a screen edge,
    // moving inward >40px (per-edge binding, any action). Plain taps and
    // short drags in the strips still reach the shell/bar; the gesture only
    // takes the touch once it triggers. Don't bind an edge occupied by a
    // swipe-driven panel (e.g. a top notification pull-down).
    // touchscreen-edge-swipe {
    //     bottom { spawn-sh "noctalia msg panel-toggle launcher"; }
    //     top { spawn-sh "…"; }
    //     left { focus-column-left; }
    //     right { focus-column-right; }
    // }

    // Corner swipes — single finger starting in the ~48px corner square,
    // moving diagonally inward >20px on both axes. Mostly-straight swipes
    // near a corner fire nothing, so the edges stay usable up to it.
    // touchscreen-corner-swipe {
    //     top-left { …; }
    //     top-right { …; }
    //     bottom-left { …; }
    //     bottom-right { …; }
    // }
}

// Using wvkbd as the OSK with a non-US system layout? A two-group xkb layout
// lets the OSK type US while the physical keyboard stays native — and
// niri-osk.sh flips the active group on toggle:
//
//     input {
//         keyboard {
//             layout "pt,us"   // your layout first, us second
//         }
//     }

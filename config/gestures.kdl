// Touchscreen gestures for the niri-tablet patchset.
//
// Include from your main config (config.kdl):
//     include "~/.config/niri/cfg/gestures.kdl"
// or paste the block straight in. Every node takes any niri action, same as
// keybinds — the ones below are a sensible starting point (the compiled
// defaults are tamer: 3-tap maximize, the rest unbound).
gestures {
    touchscreen-swipe {
        // Minimum fingers for the animated swipes (drag = view scroll
        // horizontally, workspace carousel vertically).
        fingers 3

        // 3-finger tap: maximize / restore the focused column (also the default).
        tap { maximize-column; }

        // 4-finger tap: window overview — niri-native, works everywhere.
        // Prefer an app launcher? Swap in one of these (any spawn works):
        //   Noctalia: spawn-sh "noctalia msg panel-toggle launcher"
        //   fuzzel:   spawn "fuzzel"
        //   wofi:     spawn "wofi" "--show" "drun"
        //   rofi:     spawn "rofi" "-show" "drun"
        // Or remove the node — unbound is the compiled default.
        tap-4 { toggle-overview; }

        // 4-finger flick down: close the focused window (discrete, fires on lift).
        swipe-4-down { close-window; }

        // 4-finger flick up: toggle the on-screen keyboard
        // (scripts/niri-osk.sh from this repo, at ~/.local/bin/niri-osk.sh).
        swipe-4-up { spawn-sh "~/.local/bin/niri-osk.sh"; }
    }

    // Bottom-edge swipe — implemented but unbound (default off).
    // Single finger starting within ~48px of the bottom edge, moving up
    // >40px; plain taps in that strip still reach the shell/bar.
    // touchscreen-edge-swipe { spawn-sh "…"; }
}

// Using wvkbd as the OSK with a non-US system layout? A two-group xkb layout
// lets the OSK type US while the physical keyboard stays native — and
// niri-osk.sh flips the active group on toggle:
//
//     input {
//         keyboard {
//             layout "pt,us"   // your layout first, us second
//         }
//     }

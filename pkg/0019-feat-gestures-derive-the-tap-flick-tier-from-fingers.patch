+    #[test]
+    fn gestures_touchscreen_swipe_fingers() {
+        use crate::binds::Action;
+
+        // Default is 3.
+        let parsed = Config::parse_mem("").unwrap();
+        assert_eq!(parsed.gestures.touchscreen_swipe.fingers, 3);
+
+        // 4 is accepted, and the second-tier nodes keep parsing with it.
+        let parsed = do_parse(
+            r#"
+            gestures {
+                touchscreen-swipe {
+                    fingers 4
+                    tap { focus-column-left; }
+                    tap-more { toggle-overview; }
+                    swipe-more-down { close-window; }
+                }
+            }
+            "#,
+        );
+        let swipe = &parsed.gestures.touchscreen_swipe;
+        assert_eq!(swipe.fingers, 4);
+        assert_eq!(swipe.tap, Some(Action::FocusColumnLeft));
+        assert_eq!(swipe.tap_more, Some(Action::ToggleOverview));
+        assert_eq!(swipe.swipe_more_down, Some(Action::CloseWindow));
+        assert_eq!(swipe.swipe_more_up, None);
+
+        // Anything outside 3..=4 is a hard parse error.
+        for text in [
+            r#"
+            gestures {
+                touchscreen-swipe {
+                    fingers 2
+                }
+            }
+            "#,
+            r#"
+            gestures {
+                touchscreen-swipe {
+                    fingers 5
+                }
+            }
+            "#,
+        ] {
+            let err = Config::parse_mem(text).unwrap_err();
+            let msg = format!("{err:?}");
+            assert!(msg.contains("fingers must be 3 or 4"), "{msg}");
+        }
+    }

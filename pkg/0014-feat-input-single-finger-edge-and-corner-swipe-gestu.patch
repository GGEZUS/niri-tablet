+/// Action bound to a fired edge/corner swipe zone, if any.
+fn touchscreen_edge_swipe_action(config: &Config, zone: SwipeZone) -> Option<Action> {
+    let gestures = &config.gestures;
+    match zone {
+        SwipeZone::Bottom => gestures.touchscreen_edge_swipe.bottom.clone(),
+        SwipeZone::Top => gestures.touchscreen_edge_swipe.top.clone(),
+        SwipeZone::Left => gestures.touchscreen_edge_swipe.left.clone(),
+        SwipeZone::Right => gestures.touchscreen_edge_swipe.right.clone(),
+        SwipeZone::TopLeft => gestures.touchscreen_corner_swipe.top_left.clone(),
+        SwipeZone::TopRight => gestures.touchscreen_corner_swipe.top_right.clone(),
+        SwipeZone::BottomLeft => gestures.touchscreen_corner_swipe.bottom_left.clone(),
+        SwipeZone::BottomRight => gestures.touchscreen_corner_swipe.bottom_right.clone(),
+    }
+}

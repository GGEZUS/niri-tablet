-//! Bottom-edge swipe gesture.
+//! Single-finger edge and corner swipe gestures.
 //!
-//! A single finger starting within `EDGE_ZONE_PX` of the bottom screen edge and swiping upward
-//! past `TRIGGER_PX` fires a configured command (e.g. the app launcher). A grab swallows the
-//! remaining touch events so surfaces under the finger don't receive a stray drag.
+//! A finger starting within `EDGE_ZONE_PX` of an output edge and swiping inward past
+//! `TRIGGER_PX` fires the action bound to that zone; a finger starting in a corner square and
+//! swiping diagonally inward past `CORNER_TRIGGER_PX` on both axes fires the corner's action.
+//! A grab swallows the remaining touch events so surfaces under the finger don't receive a
+//! stray drag.
 
 use smithay::backend::input::TouchSlot;
 use smithay::input::touch::{
@@ -10,81 +12,156 @@ use smithay::input::touch::{
     TouchGrab, TouchInnerHandle, UpEvent,
 };
 use smithay::input::SeatHandler;
-use smithay::utils::{Logical, Point, Serial};
+use smithay::utils::{Logical, Point, Rectangle, Serial};
 
 use crate::niri::State;
 
-/// How close to the bottom edge (logical pixels) a touch must start.
+/// How close to a screen edge (logical pixels) a touch must start to count as an edge swipe.
+/// Corner zones are the `EDGE_ZONE_PX`-sided squares where two adjacent edge strips overlap.
 const EDGE_ZONE_PX: f64 = 48.0;
 
-/// Upward movement (logical pixels) required to trigger the gesture.
+/// Inward movement (logical pixels) required to trigger an edge swipe.
 const TRIGGER_PX: f64 = 40.0;
 
+/// Per-axis inward movement (logical pixels) required to trigger a corner swipe, on BOTH
+/// axes — a mostly-straight swipe near a corner fires nothing on purpose. Half of
+/// `TRIGGER_PX`: a 45-degree diagonal covering the same on-screen distance as a straight
+/// edge swipe.
+const CORNER_TRIGGER_PX: f64 = TRIGGER_PX / 2.0;
+
+/// The zone a single-finger swipe started in, relative to the output the touch landed on.
+/// Corners win when the start is within `EDGE_ZONE_PX` of two adjacent edges.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SwipeZone {
+    Bottom,
+    Top,
+    Left,
+    Right,
+    TopLeft,
+    TopRight,
+    BottomLeft,
+    BottomRight,
+}
+
+impl SwipeZone {
+    /// Classify a start position against an output's global-logical geometry. Returns `None`
+    /// when the position is not in any edge zone. Corner zones take priority over edges;
+    /// within ties the order is deterministic (top row before bottom, left before right) —
+    /// only relevant for outputs smaller than `2 * EDGE_ZONE_PX`.
+    pub fn classify(pos: Point<f64, Logical>, geom: Rectangle<f64, Logical>) -> Option<Self> {
+        let near_left = pos.x - geom.loc.x <= EDGE_ZONE_PX;

+
+/// Actions for single-finger diagonal swipes that start within the corner
+/// zone where two edge zones meet (a ~48 logical pixel square) and move
+/// inward on both axes. Mostly-straight swipes that start in a corner zone
+/// deliberately trigger nothing, so the adjacent edges stay usable up to the
+/// corner.
+///
+/// ```kdl
+/// gestures {
+///     touchscreen-corner-swipe {
+///         top-left { focus-column-left; }
+///         bottom-right { focus-window-down; }
+///     }
+/// }
+/// ```
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct TouchscreenCornerSwipe {
+    /// Diagonal swipe down and right from the top-left corner.
+    pub top_left: Option<Action>,
+    /// Diagonal swipe down and left from the top-right corner.
+    pub top_right: Option<Action>,
+    /// Diagonal swipe up and right from the bottom-left corner.
+    pub bottom_left: Option<Action>,
+    /// Diagonal swipe up and left from the bottom-right corner.
+    pub bottom_right: Option<Action>,
+}
+
+impl TouchscreenCornerSwipe {
+    /// Whether any corner has an action bound.
+    pub fn any_bound(&self) -> bool {
+        self.top_left.is_some()
+            || self.top_right.is_some()
+            || self.bottom_left.is_some()
+            || self.bottom_right.is_some()
+    }
+}
+
+#[derive(knuffel::Decode, Debug, Default, Clone, PartialEq)]
+pub struct TouchscreenCornerSwipePart {
+    #[knuffel(child)]
+    pub top_left: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub top_right: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub bottom_left: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub bottom_right: Option<TouchscreenTap>,
+}

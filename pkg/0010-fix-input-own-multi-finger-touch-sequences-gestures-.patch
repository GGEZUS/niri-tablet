diff --git a/src/input/mod.rs b/src/input/mod.rs
index c4b370c4..a5822a0a 100644
--- a/src/input/mod.rs
+++ b/src/input/mod.rs
@@ -4089,6 +4089,50 @@ impl State {
             .touch_swipe_tracker
             .touch_down(slot, pos, Duration::from_micros(evt.time()));
 
+        // Gesture ownership: once enough fingers for a touchscreen gesture are
+        // down, the compositor owns the whole sequence until the last finger
+        // lifts. Clients have already seen the earlier fingers — cancel those
+        // touches so apps abort any pinch/drag they started — and stop
+        // delivering new ones. This keeps e.g. a browser's pinch-zoom from
+        // reacting to the start of a 3-finger swipe, or a terminal from
+        // drag-selecting under a hold-swipe.
+        let gestures_enabled =
+            !self.niri.config.borrow().gestures.touchscreen_swipe.off;
+        if gestures_enabled
+            && !self.niri.touch_input_suspended
+            && !handle.is_grabbed()
+            && (self.niri.touch_swipe_tracker.is_recognizing()
+                || self.niri.touch_swipe_tracker.is_active())
+        {
+            debug!("touch: multi-finger gesture owns the touch stream");
+            self.niri.touch_input_suspended = true;
+            // End the touches the client already sees (the first fingers
+            // that landed) with synthetic lift events — a clean, universal
+            // end for in-progress app gestures such as pinch-zoom and text
+            // selection. TouchHandle::cancel() cannot be used here: smithay
+            // skips slots whose events were already frame-flushed, so it
+            // would send nothing.
+            for tracked_slot in self.niri.touch_swipe_tracker.slots().collect::<Vec<_>>() {
+                let serial = SERIAL_COUNTER.next_serial();
+                handle.up(
+                    self,
+                    &UpEvent {
+                        slot: tracked_slot,
+                        serial,
+                        time: evt.time_msec(),
+                    },
+                );
+            }
+            handle.frame(self);
+            self.niri.touch_edge_swipe_tracker.reset();
+        }
+
+        if self.niri.touch_input_suspended {
+            // The gesture owns this sequence: swallow delivery to surfaces.
+            self.niri.pointer_visibility = PointerVisibility::Disabled;
+            return;
+        }
+
         // Feed the bottom-edge swipe tracker (e.g. launcher gesture).
         if !self
             .niri
@@ -4282,23 +4326,32 @@ impl State {
         // Bottom-edge swipe tracker.
         self.niri.touch_edge_swipe_tracker.touch_up(slot);
 
-        if let Some(capture) = self.niri.screenshot_ui.pointer_up(Some(slot)) {
-            if capture {
-                self.confirm_screenshot(true);
-            } else {
-                self.niri.queue_redraw_all();
-            }
+        // The last finger lifted: the gesture no longer owns the touch
+        // stream, resume normal client delivery.
+        if self.niri.touch_input_suspended && self.niri.touch_swipe_tracker.is_idle() {
+            debug!("touch: multi-finger gesture ended, resuming client input");
+            self.niri.touch_input_suspended = false;
         }
 
-        let serial = SERIAL_COUNTER.next_serial();
-        handle.up(
-            self,
-            &UpEvent {
-                slot,
-                serial,
-                time: evt.time_msec(),
-            },
-        );
+        if !self.niri.touch_input_suspended {
+            if let Some(capture) = self.niri.screenshot_ui.pointer_up(Some(slot)) {
+                if capture {
+                    self.confirm_screenshot(true);
+                } else {
+                    self.niri.queue_redraw_all();
+                }
+            }
+
+            let serial = SERIAL_COUNTER.next_serial();
+            handle.up(
+                self,
+                &UpEvent {
+                    slot,
+                    serial,
+                    time: evt.time_msec(),
+                },
+            );
+        }
 
         // Run a deferred discrete-gesture action now that all grab callbacks
         // (and the seat's touch lock) have returned.
@@ -4417,6 +4470,11 @@ impl State {
                                     location: pos,
                                 };
 
+                                // The gesture grab owns the stream from here and
+                                // does its own swallowing (passes null focus), so
+                                // input suspension is no longer needed.
+                                self.niri.touch_input_suspended = false;
+
                                 if let Some(action) = discrete_action {
                                     let grab = TouchSwipeGrab::new_discrete(
                                         start_data, output, tracker, action,
@@ -4464,7 +4522,9 @@ impl State {
         }
 
         // Bottom-edge swipe (e.g. launcher gesture).
-        if self.niri.touch_edge_swipe_tracker.touch_motion(slot, pos) {
+        if !self.niri.touch_input_suspended
+            && self.niri.touch_edge_swipe_tracker.touch_motion(slot, pos)
+        {
             let dominated = self.niri.screenshot_ui.is_open() || self.niri.window_mru_ui.is_open();
             if dominated {
                 self.niri.touch_edge_swipe_tracker.reset();
@@ -4485,7 +4545,20 @@ impl State {
                 }
 
                 // Swallow the rest of this gesture so surfaces under the finger
-                // don't receive a stray drag.
+                // don't receive a stray drag. End the touch the client has
+                // already seen with a synthetic lift first — the grab will
+                // swallow the real one (TouchHandle::cancel is unreliable,
+                // see the gesture-ownership handling in on_touch_down).
+                let up_serial = SERIAL_COUNTER.next_serial();
+                handle.up(
+                    self,
+                    &UpEvent {
+                        slot,
+                        serial: up_serial,
+                        time: evt.time_msec(),
+                    },
+                );
+
                 let start_data = TouchGrabStartData {
                     focus: None,
                     slot,
@@ -4502,6 +4575,11 @@ impl State {
             }
         }
 
+        if self.niri.touch_input_suspended {
+            // The gesture owns this sequence: swallow delivery to surfaces.
+            return;
+        }
+
         if let Some(output) = self.niri.screenshot_ui.selection_output().cloned() {
             let geom = self.niri.global_space.output_geometry(&output).unwrap();
             let mut point = (pos - geom.loc.to_f64())
@@ -4552,6 +4630,7 @@ impl State {
         };
         // Reset the pre-grab tracker so stale state doesn't carry over.
         self.niri.touch_swipe_tracker.reset();
+        self.niri.touch_input_suspended = false;
         if self.niri.config.borrow().gestures.show_touch_points != ShowTouchPoints::Off
             && !self.niri.touch_points.is_empty()
         {

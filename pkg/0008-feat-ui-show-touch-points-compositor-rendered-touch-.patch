+/// Touch point visualization mode.
+///
+/// ```kdl
+/// gestures {
+///     show-touch-points "all"       // every finger gets a dot
+///     show-touch-points "gestures"  // dots only while enough fingers are
+///                                   // down for a gesture (3/4-finger
+///                                   // swipes, taps)
+/// }
+/// ```
+#[derive(knuffel::DecodeScalar, Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum ShowTouchPoints {
+    #[default]
+    Off,
+    /// Every touch point gets a dot.
+    All,
+    /// Dots appear only while at least `touchscreen-swipe.fingers` slots are
+    /// down — the touches that can drive (or already are) a gesture.
+    Gestures,
+}

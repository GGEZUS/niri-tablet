diff --git a/src/input/touch_edge_swipe.rs b/src/input/touch_edge_swipe.rs
new file mode 100644
index 00000000..800ee3d5
--- /dev/null
+++ b/src/input/touch_edge_swipe.rs
@@ -0,0 +1,240 @@
+//! Bottom-edge swipe gesture.
+//!
+//! A single finger starting within `EDGE_ZONE_PX` of the bottom screen edge and swiping upward
+//! past `TRIGGER_PX` fires a configured command (e.g. the app launcher). A grab swallows the
+//! remaining touch events so surfaces under the finger don't receive a stray drag.
+
+use smithay::backend::input::TouchSlot;
+use smithay::input::touch::{
+    DownEvent, GrabStartData as TouchGrabStartData, MotionEvent, OrientationEvent, ShapeEvent,
+    TouchGrab, TouchInnerHandle, UpEvent,
+};
+use smithay::input::SeatHandler;
+use smithay::utils::{Logical, Point, Serial};
+
+use crate::niri::State;
+
+/// How close to the bottom edge (logical pixels) a touch must start.
+const EDGE_ZONE_PX: f64 = 48.0;
+
+/// Upward movement (logical pixels) required to trigger the gesture.
+const TRIGGER_PX: f64 = 40.0;
+
+#[derive(Debug, Default)]
+pub struct EdgeSwipeTracker {
+    /// The tracked finger, if a single-finger edge gesture is in progress.
+    slot: Option<TouchSlot>,
+    /// Where the tracked finger started.
+    start: Point<f64, Logical>,
+    /// Logical Y coordinate of the bottom edge of the output where tracking started.
+    bottom_edge_y: f64,
+    /// Whether the gesture already fired; further motion is ignored until the finger lifts.
+    latched: bool,
+}
+
+impl EdgeSwipeTracker {
+    pub fn touch_down(&mut self, slot: TouchSlot, pos: Point<f64, Logical>, bottom_edge_y: f64) {
+        if self.slot.is_some() {
+            // A second finger landed; this is not a clean single-finger gesture.
+            self.slot = None;
+            return;
+        }
+
+        if pos.y >= bottom_edge_y - EDGE_ZONE_PX {
+            debug!(
+                "touch_edge_swipe: tracking from y={:.0} (bottom edge at {:.0})",
+                pos.y, bottom_edge_y
+            );
+            self.slot = Some(slot);
+            self.start = pos;
+            self.bottom_edge_y = bottom_edge_y;
+            self.latched = false;
+        } else if pos.y >= bottom_edge_y - EDGE_ZONE_PX * 2.0 {
+            debug!(
+                "touch_edge_swipe: near-miss start y={:.0} (zone starts at {:.0})",
+                pos.y,
+                bottom_edge_y - EDGE_ZONE_PX
+            );
+        }
+    }
+
+    /// Feed finger motion; returns `true` exactly once when the upward swipe triggers.
+    pub fn touch_motion(&mut self, slot: TouchSlot, pos: Point<f64, Logical>) -> bool {
+        if self.slot != Some(slot) || self.latched {
+            return false;
+        }
+
+        let dx = pos.x - self.start.x;
+        let dy = pos.y - self.start.y;
+
+        if dy <= -TRIGGER_PX && dy.abs() >= dx.abs() {
+            self.latched = true;
+            debug!("touch_edge_swipe: bottom edge swipe triggered");
+            return true;
+        }
+
+        false
+    }
+
+    pub fn touch_up(&mut self, slot: TouchSlot) {
+        if self.slot == Some(slot) {
+            self.slot = None;
+        }
+    }
+
+    /// Drop any in-progress tracking.
+    pub fn reset(&mut self) {
+        self.slot = None;
+    }
+}
+
+/// Swallows touch events for the remainder of an edge swipe so surfaces under the finger don't
+/// receive a stray drag after the gesture fires.
+pub struct EdgeSwipeGrab {
+    start_data: TouchGrabStartData<State>,
+    slot: TouchSlot,
+}
+
+impl EdgeSwipeGrab {
+    pub fn new(start_data: TouchGrabStartData<State>, slot: TouchSlot) -> Self {
+        Self { start_data, slot }
+    }
+}
+
+impl TouchGrab<State> for EdgeSwipeGrab {
+    fn down(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        _event: &DownEvent,
+        _seq: Serial,
+    ) {
+        // Swallowed.
+    }
+
+    fn up(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &UpEvent,
+        _seq: Serial,
+    ) {
+        // Swallowed; release the grab when the initiating finger lifts.
+        if event.slot == self.slot {
+            handle.unset_grab(self, data);
+        }
+    }
+
+    fn motion(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        _event: &MotionEvent,
+        _seq: Serial,
+    ) {
+        // Swallowed.
+    }
+
+    fn frame(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _seq: Serial,
+    ) {
+        // Swallowed.
+    }
+
+    fn cancel(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        _seq: Serial,
+    ) {
+        handle.unset_grab(self, data);
+    }
+
+    fn shape(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _event: &ShapeEvent,
+        _seq: Serial,
+    ) {
+        // Swallowed.
+    }
+
+    fn orientation(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _event: &OrientationEvent,
+        _seq: Serial,
+    ) {
+        // Swallowed.
+    }
+
+    fn start_data(&self) -> &TouchGrabStartData<State> {
+        &self.start_data
+    }
+
+    fn unset(&mut self, _data: &mut State) {}
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn slot(id: u32) -> TouchSlot {
+        TouchSlot::from(Some(id))
+    }
+
+    fn pt(x: f64, y: f64) -> Point<f64, Logical> {
+        Point::from((x, y))
+    }
+
+    #[test]
+    fn swipe_up_from_bottom_edge_triggers() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), 1280.0);
+        assert!(!tracker.touch_motion(slot(0), pt(500.0, 1240.0)));
+        assert!(tracker.touch_motion(slot(0), pt(500.0, 1220.0)));
+        // Latched: no second trigger.
+        assert!(!tracker.touch_motion(slot(0), pt(500.0, 1000.0)));
+    }
+
+    #[test]
+    fn swipe_down_or_sideways_does_not_trigger() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), 1280.0);
+        assert!(!tracker.touch_motion(slot(0), pt(500.0, 1300.0)));
+        // Mostly-horizontal movement past the threshold.
+        assert!(!tracker.touch_motion(slot(0), pt(700.0, 1240.0)));
+    }
+
+    #[test]
+    fn touch_outside_edge_zone_ignored() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1000.0), 1280.0);
+        assert!(!tracker.touch_motion(slot(0), pt(500.0, 900.0)));
+    }
+
+    #[test]
+    fn second_finger_aborts() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), 1280.0);
+        tracker.touch_down(slot(1), pt(600.0, 1270.0), 1280.0);
+        assert!(!tracker.touch_motion(slot(0), pt(500.0, 1200.0)));
+    }
+
+    #[test]
+    fn rearms_after_finger_lifts() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), 1280.0);
+        assert!(tracker.touch_motion(slot(0), pt(500.0, 1220.0)));
+        tracker.touch_up(slot(0));
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), 1280.0);
+        assert!(tracker.touch_motion(slot(0), pt(500.0, 1220.0)));
+    }
+}

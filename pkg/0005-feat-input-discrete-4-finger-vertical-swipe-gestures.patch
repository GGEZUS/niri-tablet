                                 );
                                 let start_data = TouchGrabStartData {
                                     focus: None,
                                     slot,
                                     location: pos,
                                 };
+
+                                if let Some(action) = discrete_action {
+                                    let grab = TouchSwipeGrab::new_discrete(
+                                        start_data, output, tracker, action,
+                                    );
+                                    let serial = SERIAL_COUNTER.next_serial();
+                                    // Unset any existing implicit grab before setting ours.
+                                    handle.unset_grab(self);
+                                    handle.set_grab(self, grab, serial);
+                                    self.niri.touch_edge_swipe_tracker.reset();
+                                    return;
+                                }
+
                                 let grab = TouchSwipeGrab::new(start_data, output.clone(), tracker);
                                 let serial = SERIAL_COUNTER.next_serial();
                                 // Unset any existing implicit grab before setting ours.
@@ -4344,12 +4378,9 @@ impl State {
                                         self.niri
                                             .layout
                                             .workspace_switch_gesture_begin(&output, false);
-                                        // Direct manipulation on a touchscreen: the content
-                                        // follows the finger (delta as-is, not negated like
-                                        // the touchpad path).
                                         self.niri
                                             .layout
-                                            .workspace_switch_gesture_update(delta_y, ts, false);
+                                            .workspace_switch_gesture_update(-delta_y, ts, false);
                                     }
                                 }

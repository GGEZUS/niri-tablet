 src/input/mod.rs                 | 47 +++++++++++++++----
 src/input/touch_swipe_grab.rs    | 79 +++++++++++++++++++++++---------
 src/input/touch_swipe_tracker.rs |  3 ++
 4 files changed, 118 insertions(+), 29 deletions(-)


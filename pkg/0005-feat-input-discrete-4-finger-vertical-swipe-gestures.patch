--- a/niri-config/src/gestures.rs
+++ b/niri-config/src/gestures.rs
@@ -130,6 +130,12 @@ pub struct TouchscreenSwipe {
     pub tap: Option<Action>,
     /// Action for taps involving four or more fingers; overrides `tap` for those.
     pub tap_4: Option<Action>,
+    /// Discrete action for a vertical swipe with four or more fingers
+    /// (downward). When unset, such swipes drive the workspace carousel.
+    pub swipe_4_down: Option<Action>,
+    /// Discrete action for a vertical swipe with four or more fingers
+    /// (upward). When unset, such swipes drive the workspace carousel.
+    pub swipe_4_up: Option<Action>,
 }
 
 impl Default for TouchscreenSwipe {
@@ -139,6 +145,8 @@ impl Default for TouchscreenSwipe {
             fingers: 3,
             tap: Some(Action::MaximizeColumn),
             tap_4: None,
+            swipe_4_down: None,
+            swipe_4_up: None,
         }
     }
 }
@@ -153,6 +161,10 @@ pub struct TouchscreenSwipePart {
     pub tap: Option<TouchscreenTap>,
     #[knuffel(child)]
     pub tap_4: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub swipe_4_down: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub swipe_4_up: Option<TouchscreenTap>,
 }
 
 impl MergeWith<TouchscreenSwipePart> for TouchscreenSwipe {
@@ -167,6 +179,12 @@ impl MergeWith<TouchscreenSwipePart> for TouchscreenSwipe {
         if let Some(tap_4) = &part.tap_4 {
             self.tap_4 = Some(tap_4.action.clone());
         }
+        if let Some(a) = &part.swipe_4_down {
+            self.swipe_4_down = Some(a.action.clone());
+        }
+        if let Some(a) = &part.swipe_4_up {
+            self.swipe_4_up = Some(a.action.clone());
+        }
     }
 }
 

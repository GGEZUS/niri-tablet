+/// Discrete actions for "hold then swipe" touchscreen gestures: the fingers
+/// rest still for a moment (about 400ms) before moving past the swipe
+/// threshold, then the dominant swipe direction picks the action. Quick
+/// swipes are unaffected — they keep driving the animated view scroll /
+/// workspace carousel.
+///
+/// ```kdl
+/// gestures {
+///     touchscreen-swipe {
+///         hold {
+///             left { move-column-left; }
+///             right { move-column-right; }
+///             up { move-window-to-workspace-up; }
+///             down { move-window-to-workspace-down; }
+///         }
+///     }
+/// }
+/// ```
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct TouchscreenSwipeHold {
+    /// Action for a held swipe whose dominant movement is to the left.
+    pub left: Option<Action>,
+    /// Action for a held swipe whose dominant movement is to the right.
+    pub right: Option<Action>,
+    /// Action for a held swipe whose dominant movement is upward.
+    pub up: Option<Action>,
+    /// Action for a held swipe whose dominant movement is downward.
+    pub down: Option<Action>,
+}
+
+#[derive(knuffel::Decode, Debug, Default, Clone, PartialEq)]
+pub struct TouchscreenSwipeHoldPart {
+    #[knuffel(child)]
+    pub left: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub right: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub up: Option<TouchscreenTap>,
+    #[knuffel(child)]
+    pub down: Option<TouchscreenTap>,
+}
+
+impl MergeWith<TouchscreenSwipeHoldPart> for TouchscreenSwipeHold {
+    fn merge_with(&mut self, part: &TouchscreenSwipeHoldPart) {
+        if let Some(a) = &part.left {
+            self.left = Some(a.action.clone());
+        }
+        if let Some(a) = &part.right {
+            self.right = Some(a.action.clone());
+        }
+        if let Some(a) = &part.up {
+            self.up = Some(a.action.clone());
+        }
+        if let Some(a) = &part.down {
+            self.down = Some(a.action.clone());
+        }
     }
 }
 

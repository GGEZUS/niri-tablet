+/// What a quick horizontal touchscreen swipe does.
+///
+/// ```kdl
+/// gestures {
+///     touchscreen-swipe {
+///         horizontal-swipe "move-view"       // animated view scroll (default)
+///         horizontal-swipe "resize-column"   // resize the focused window's
+///                                           // width, tracking the fingers
+///     }
+/// }
+/// ```
+#[derive(knuffel::DecodeScalar, Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum HorizontalSwipe {
+    #[default]
+    MoveView,
+    /// The swipe tracks the focused window's width 1:1: dragging right widens
+    /// (tiled: the focused column; floating: the focused window), the width
+    /// stays where the fingers left it.
+    ResizeColumn,
+}
+

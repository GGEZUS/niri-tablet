+                                            if self.niri.config.borrow().gestures.debug_log {
+                                                info!(
+                                                    "gesture-debug: column resize begin (horizontal swipe)"
+                                                );
+                                            }
+                                            let grab = TouchSwipeGrab::new_column_resize(
+                                                start_data,
+                                                output.clone(),
+                                                tracker,
+                                                window.clone(),
+                                                delta_x,
+                                            );
+                                            let serial = SERIAL_COUNTER.next_serial();
+                                            // Unset any existing implicit grab before
+                                            // setting ours.
+                                            handle.unset_grab(self);
+                                            handle.set_grab(self, grab, serial);
